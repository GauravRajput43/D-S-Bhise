<% layout("/layouts/boilerplate") %>
<body>
  <!-- ================= HERO ================= -->

  <section class="main">
    <div class="image">
      <div class="container">
        <div class="row align-items-center min-vh-75 py-5">
          <div class="col-12 col-md-9 col-lg-7 text-white">
            <p class="fs-5">Chartered Accountant Services</p>

            <h1 class="display-4 fw-bold">
              Smart Financial Solutions
              <br />

              for a
              <span class="text-success"> Better Tomorrow </span>
            </h1>

            <p class="lead mt-3">
              We help individuals, businesses and startups with trusted
              accounting, taxation and financial advisory services.
            </p>

            <!-- Buttons -->

            <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
              <a href="/Book" class="btn btn-success btn-lg">
                <i class="fa-solid fa-address-book"></i>

                Book Consultation
              </a>

              <a href="/Book/services" class="btn btn-light btn-lg">
                Explore Our Services
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TRUST SECTION ================= -->

  <section class="chart py-5">
    <div class="container">
      <div class="row g-4">
        <!-- Box 1 -->

        <div class="col-12 col-md-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon">
              <i class="fa-solid fa-heart-circle-check"></i>
            </div>

            <div>
              <h6 class="mb-1">Trusted & Verified</h6>

              <p class="mb-0 text-muted">With Professional experience</p>
            </div>
          </div>
        </div>

        <!-- Box 2 -->

        <div class="col-12 col-md-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon">
              <i class="fa-solid fa-users"></i>
            </div>

            <div>
              <h6 class="mb-1">Personalised Advice</h6>

              <p class="mb-0 text-muted">Solution as per your need</p>
            </div>
          </div>
        </div>

        <!-- Box 3 -->

        <div class="col-12 col-md-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon">
              <i class="fa-solid fa-clock"></i>
            </div>

            <div>
              <h6 class="mb-1">On-time Support</h6>

              <p class="mb-0 text-muted">Quick & reliable service</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->

  <section class="second py-5" id="services">
    <div class="container">
      <div class="row g-4">
        <!-- LEFT -->

        <div class="col-12 col-lg-4">
          <p class="text-success fw-bold mb-2">Our Services</p>

          <h2 class="display-6 fw-bold">What we do</h2>

          <p class="text-muted mt-3">
            We offer a wide range of professional services to help you manage
            your finances and grow with confidence.
          </p>

          <button class="btn btn-success mt-2">View All Services</button>
        </div>

        <!-- RIGHT CARDS -->

        <div class="col-12 col-lg-8">
          <div class="row g-4">
            <!-- Card 1 -->

            <div class="col-12 col-md-6 col-xl-4">
              <div class="servDiv h-100 p-4">
                <div class="icon2">
                  <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>

                <h5 class="mt-3">Income Tax Filing</h5>

                <p class="text-muted">
                  ITR filing for individuals, HUF, firms and companies.
                </p>
              </div>
            </div>

            <!-- Card 2 -->

            <div class="col-12 col-md-6 col-xl-4">
              <div class="servDiv h-100 p-4">
                <div class="icon2">
                  <i class="fa-solid fa-indian-rupee-sign"></i>
                </div>

                <h5 class="mt-3">GST Services</h5>

                <p class="text-muted">
                  Registration, return filing, compliance & advisory.
                </p>
              </div>
            </div>

            <!-- Card 3 -->

            <div class="col-12 col-md-6 col-xl-4">
              <div class="servDiv h-100 p-4">
                <div class="icon2">
                  <i class="fa-solid fa-arrow-trend-up"></i>
                </div>

                <h5 class="mt-3">Accounting & Book Keeping</h5>

                <p class="text-muted">
                  Maintain accurate records and financial statements.
                </p>
              </div>
            </div>

            <!-- Card 4 -->

            <div class="col-12 col-md-6 col-xl-4">
              <div class="servDiv h-100 p-4">
                <div class="icon2">
                  <i class="fa-solid fa-users"></i>
                </div>

                <h5 class="mt-3">Business Registration</h5>

                <p class="text-muted">
                  Proprietorship, Partnership, LLP, Private Limited etc.
                </p>
              </div>
            </div>

            <!-- Card 5 -->

            <div class="col-12 col-md-6 col-xl-4">
              <div class="servDiv h-100 p-4">
                <div class="icon2">
                  <i class="fa-solid fa-indian-rupee-sign"></i>
                </div>

                <h5 class="mt-3">Financial Advisory</h5>

                <p class="text-muted">
                  Investment planning, tax planning and wealth management.
                </p>
              </div>
            </div>

            <!-- Card 6 -->

            <div class="col-12 col-md-6 col-xl-4">
              <div class="servDiv h-100 p-4">
                <div class="icon2">
                  <i class="fa-solid fa-chart-line"></i>
                </div>

                <h5 class="mt-3">Audit & Assurance</h5>

                <p class="text-muted">
                  Statutory audit, internal audit and compliance audit.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bootstrap JS -->

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
