<% layout("/layouts/boilerplate") %>

<body>
  <!-- ================= CONTACT HERO ================= -->

  <section class="contact-hero">
    <div class="container">
      <div class="row">
        <div class="col-lg-9">
          <span class="hero-small"> Contact DS Bhise & Company </span>

          <h1>
            Let’s Talk About Your<br />
            Business & Finances.
          </h1>

          <p>
            Whether you need help with taxation, GST, accounting, compliance or
            business advisory, our team is ready to understand your requirements
            and guide you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CONTACT CARD ================= -->

  <section class="contact-wrapper">
    <div class="container">
      <div class="contact-card">
        <div class="row g-0">
          <!-- LEFT INFORMATION -->

          <div class="col-lg-5">
            <div class="contact-info">
              <h2>Get in Touch</h2>

              <p>
                Have a question or need professional assistance? Send us your
                requirement and our team will get back to you shortly.
              </p>

              <!-- PHONE -->

              <div class="info-item">
                <div class="info-icon">
                  <i class="fa-solid fa-phone"></i>
                </div>

                <div>
                  <h6>Call Us</h6>

                  <p>
                    <a href="tel:+919876543210" class="contact-link">
                      +91 98765 43210
                    </a>
                  </p>
                </div>
              </div>

              <!-- EMAIL -->

              <div class="info-item">
                <div class="info-icon">
                  <i class="fa-solid fa-envelope"></i>
                </div>

                <div>
                  <h6>Email Us</h6>

                  <p>
                    <a href="mailto:info@dsbhise.com" class="contact-link">
                      info@dsbhise.com
                    </a>
                  </p>
                </div>
              </div>

              <!-- ADDRESS -->

              <div class="info-item">
                <div class="info-icon">
                  <i class="fa-solid fa-location-dot"></i>
                </div>

                <div>
                  <h6>Office Address</h6>

                  <p>
                    Your Office Address,<br />
                    Maharashtra, India
                  </p>
                </div>
              </div>

              <!-- BUSINESS HOURS -->

              <div class="info-item">
                <div class="info-icon">
                  <i class="fa-regular fa-clock"></i>
                </div>

                <div>
                  <h6>Business Hours</h6>

                  <p>
                    Monday – Saturday<br />
                    10:00 AM – 7:00 PM
                  </p>
                </div>
              </div>

              <!-- SOCIAL -->

              <div class="social-links">
                <a href="#">
                  <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="#">
                  <i class="fa-brands fa-instagram"></i>
                </a>

                <a href="#">
                  <i class="fa-brands fa-linkedin-in"></i>
                </a>

                <a href="#">
                  <i class="fa-brands fa-x-twitter"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- RIGHT FORM -->

          <div class="col-lg-7">
            <div class="contact-form">
              <h2 class="form-title">Send Us a Message</h2>

              <p class="form-subtitle">
                Fill in the details below and tell us how we can help.
              </p>

              <form action="/Book/welcome" method="post">
                <div class="row g-4">
                  <!-- NAME -->

                  <div class="col-md-6">
                    <label class="form-label"> Full Name </label>

                    <input
                      type="text"
                      class="form-control"
                      name="name"
                      placeholder="Enter your name"
                      required
                    />
                  </div>

                  <!-- PHONE -->

                  <div class="col-md-6">
                    <label class="form-label"> Phone Number </label>

                    <input
                      type="tel"
                      class="form-control"
                      name="Phone"
                      placeholder="+91 XXXXX XXXXX"
                      required
                    />
                  </div>

                  <!-- EMAIL -->

                  <div class="col-md-6">
                    <label class="form-label"> Email Address </label>

                    <input
                      type="email"
                      name="Email"
                      class="form-control"
                      placeholder="you@example.com"
                      required
                    />
                  </div>

                  <!-- SERVICE -->

                  <div class="col-md-6">
                    <label class="form-label"> Service Required </label>

                    <select class="form-select" name="service" required>
                      <option value="">Select a service</option>

                      <option>Income Tax / ITR</option>
                      <option>GST Registration</option>
                      <option>GST Return Filing</option>
                      <option>Accounting & Bookkeeping</option>
                      <option>Business Registration</option>
                      <option>Audit & Compliance</option>
                      <option>Tax Planning</option>
                      <option>Business Advisory</option>
                      <option>Other</option>
                    </select>
                  </div>

                  <!-- SUBJECT -->

                  <div class="col-12">
                    <label class="form-label"> Subject </label>

                    <input
                      type="text"
                      class="form-control"
                      name="help"
                      placeholder="What do you need help with?"
                    />
                  </div>

                  <!-- MESSAGE -->

                  <div class="col-12">
                    <label class="form-label"> Your Message </label>

                    <textarea
                      class="form-control"
                      name="Message"
                      placeholder="Tell us briefly about your requirement..."
                    ></textarea>
                  </div>

                  <!-- SUBMIT -->

                  <div class="col-12">
                    <button type="submit" class="submit-btn">
                      Send Enquiry

                      <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                  </div>
                </div>
              </form>

              <!-- QUICK CONTACT -->

              <div class="quick-box">
                <a href="tel:+919876543210" class="quick-btn call-btn">
                  <i class="fa-solid fa-phone"></i>
                  Call Now
                </a>

                <a
                  href="https://wa.me/919876543210"
                  target="_blank"
                  class="quick-btn whatsapp-btn"
                >
                  <i class="fa-brands fa-whatsapp"></i>
                  WhatsApp Us
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->

  <section class="stats-section">
    <div class="container">
      <div class="row g-4">
        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <i class="fa-solid fa-users"></i>
            <h3>500+</h3>
            <p>Clients Served</p>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <i class="fa-solid fa-file-circle-check"></i>
            <h3>1000+</h3>
            <p>Returns Filed</p>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <i class="fa-solid fa-briefcase"></i>
            <h3>10+</h3>
            <p>Years Experience</p>
          </div>
        </div>

        <div class="col-6 col-lg-3">
          <div class="stat-card">
            <i class="fa-solid fa-headset"></i>
            <h3>24/7</h3>
            <p>Client Support</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MAP ================= -->

  <section class="map-section">
    <div class="container">
      <div class="section-heading">
        <span>Visit Our Office</span>

        <h2>Find Us</h2>
      </div>

      <div class="map-box">
        <iframe
          src="https://www.google.com/maps?q=Maharashtra,India&output=embed"
          loading="lazy"
          allowfullscreen
        >
        </iframe>
      </div>
    </div>
  </section>

  <!-- ================= FAQ ================= -->

  <section class="faq-section">
    <div class="container">
      <div class="section-heading">
        <span>Need Help?</span>

        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-9">
          <div class="accordion" id="faqAccordion">
            <!-- FAQ 1 -->

            <div class="accordion-item">
              <h2 class="accordion-header">
                <button
                  class="accordion-button"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faqOne"
                >
                  How can I contact your CA team?
                </button>
              </h2>

              <div
                id="faqOne"
                class="accordion-collapse collapse show"
                data-bs-parent="#faqAccordion"
              >
                <div class="accordion-body">
                  You can contact us through phone, email, WhatsApp or by
                  submitting the enquiry form above.
                </div>
              </div>
            </div>

            <!-- FAQ 2 -->

            <div class="accordion-item">
              <h2 class="accordion-header">
                <button
                  class="accordion-button collapsed"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faqTwo"
                >
                  What services do you provide?
                </button>
              </h2>

              <div
                id="faqTwo"
                class="accordion-collapse collapse"
                data-bs-parent="#faqAccordion"
              >
                <div class="accordion-body">
                  We provide services related to Income Tax, GST, accounting,
                  audit, business registration, compliance and tax advisory.
                </div>
              </div>
            </div>

            <!-- FAQ 3 -->

            <div class="accordion-item">
              <h2 class="accordion-header">
                <button
                  class="accordion-button collapsed"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faqThree"
                >
                  Can I get an online consultation?
                </button>
              </h2>

              <div
                id="faqThree"
                class="accordion-collapse collapse"
                data-bs-parent="#faqAccordion"
              >
                <div class="accordion-body">
                  Yes. Online consultations can be conducted through phone,
                  WhatsApp or video call, depending on your requirement.
                </div>
              </div>
            </div>

            <!-- FAQ 4 -->

            <div class="accordion-item">
              <h2 class="accordion-header">
                <button
                  class="accordion-button collapsed"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faqFour"
                >
                  How quickly will you respond?
                </button>
              </h2>

              <div
                id="faqFour"
                class="accordion-collapse collapse"
                data-bs-parent="#faqAccordion"
              >
                <div class="accordion-body">
                  Our team generally responds during business hours. For urgent
                  requirements, you can directly call or WhatsApp us.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->

  <section class="bottom-cta">
    <div class="container">
      <h2>Have a Tax or Business Question?</h2>

      <p>
        Don't let financial and compliance questions become complicated. Talk to
        our team and get professional guidance for your requirement.
      </p>

      <a href="https://wa.me/919876543210" target="_blank" class="cta-btn">
        <i class="fa-brands fa-whatsapp me-2"></i>

        Chat on WhatsApp
      </a>
    </div>
  </section>
</body>
