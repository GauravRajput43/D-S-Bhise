<% layout("/layouts/boilerplate") %>
<!-- =========================
     ABOUT HERO
========================= -->

<section class="about-hero">
  <div class="container">
    <div class="about-hero-content">
      <div class="about-label">About Our Firm</div>

      <h1>
        Numbers Tell a Story.
        <br />
        We Help You Write It.
      </h1>

      <p>
        At DS Bhise & Company, we combine financial expertise, strategic
        thinking and personalized service to help businesses and individuals
        build a stronger financial future.
      </p>

      <div class="about-hero-buttons">
        <a href="#our-story" class="about-btn about-btn-gold">
          Discover Our Story
        </a>

        <a href="/contactUs" class="about-btn about-btn-outline">
          Talk to an Expert
        </a>
      </div>
    </div>
  </div>
</section>

<!-- =========================
     OUR STORY
========================= -->

<section class="about-story" id="our-story">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <div class="about-story-image">
          <img
            src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1000&q=85"
            alt="Professional CA Team"
          />

          <div class="about-experience">
            <strong>15+</strong>

            <span> Years of professional experience </span>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="about-story-content">
          <div class="about-section-label">Who We Are</div>

          <h2>
            More Than Accountants.
            <br />
            Your Financial Partners.
          </h2>

          <p>
            DS Bhise & Company is a professional Chartered Accountancy firm
            committed to delivering reliable, transparent and practical
            financial solutions.
          </p>

          <p>
            We work closely with entrepreneurs, businesses, professionals and
            individuals to simplify complex financial matters and create
            meaningful opportunities for growth.
          </p>

          <p>
            Our approach goes beyond compliance. We believe every financial
            decision should support a larger business objective.
          </p>

          <div class="about-signature">
            <strong>CA D. S. Bhise</strong>

            <span> Founder & Chartered Accountant </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================
     STATS
========================= -->

<section class="about-stats">
  <div class="container">
    <div class="row g-0">
      <div class="col-lg-3 col-6">
        <div class="about-stat">
          <i class="fa-solid fa-calendar-check"></i>

          <strong>15+</strong>

          <span> Years Experience </span>
        </div>
      </div>

      <div class="col-lg-3 col-6">
        <div class="about-stat">
          <i class="fa-solid fa-users"></i>

          <strong>500+</strong>

          <span> Clients Served </span>
        </div>
      </div>

      <div class="col-lg-3 col-6">
        <div class="about-stat">
          <i class="fa-solid fa-chart-line"></i>

          <strong>1000+</strong>

          <span> Projects Completed </span>
        </div>
      </div>

      <div class="col-lg-3 col-6">
        <div class="about-stat">
          <i class="fa-solid fa-handshake"></i>

          <strong>98%</strong>

          <span> Client Retention </span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================
     OUR VALUES
========================= -->

<section class="about-values">
  <div class="container">
    <div class="about-heading">
      <div class="about-section-label">What Drives Us</div>

      <h2>Principles Behind Every Decision</h2>

      <p>
        Our work is built on a simple philosophy: deliver accurate advice,
        communicate clearly and always put long-term value first.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <div class="about-value-card">
          <div class="about-value-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h3>Integrity</h3>

          <p>
            We maintain the highest standards of professional ethics,
            confidentiality and transparency in every engagement.
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="about-value-card">
          <div class="about-value-icon">
            <i class="fa-solid fa-bullseye"></i>
          </div>

          <h3>Precision</h3>

          <p>
            Financial decisions demand accuracy. We focus on detailed analysis
            and dependable financial reporting.
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="about-value-card">
          <div class="about-value-icon">
            <i class="fa-solid fa-lightbulb"></i>
          </div>

          <h3>Insight</h3>

          <p>
            We turn financial information into practical insights that help
            clients understand opportunities and risks.
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="about-value-card">
          <div class="about-value-icon">
            <i class="fa-solid fa-user-tie"></i>
          </div>

          <h3>Personal Attention</h3>

          <p>
            Every client has different goals. Our solutions are designed around
            individual business and financial needs.
          </p>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="about-value-card">
          <div class="about-value-icon">```</div>
        </div>
      </div>
    </div>
  </div>
</section>
