<% layout("/layouts/boilerplate") %>
<!-- ================= SUCCESS PAGE ================= -->

<section class="success-page">
  <div class="container">
    <div class="success-card">
      <!-- SUCCESS ICON -->

      <div class="success-icon">
        <i class="fa-solid fa-check"></i>
      </div>

      <!-- TITLE -->

      <span class="success-label"> ENQUIRY RECEIVED </span>

      <h1>
        Thank You for<br />
        Contacting Us!
      </h1>

      <!-- MESSAGE -->

      <p class="success-message">
        Your information has been successfully submitted. We have received your
        enquiry and our team will review your requirement shortly.
      </p>

      <p class="callback-message">
        <i class="fa-solid fa-phone-volume"></i>

        One of our representatives from
        <strong>DS Bhise & Company</strong>
        will contact you soon to understand your requirement and assist you
        further.
      </p>

      <!-- INFO BOX -->

      <div class="next-step-box">
        <div class="next-step">
          <div class="step-icon">
            <i class="fa-solid fa-file-circle-check"></i>
          </div>

          <div>
            <h5>Information Received</h5>
            <p>Your enquiry details have been successfully received.</p>
          </div>
        </div>

        <div class="next-step">
          <div class="step-icon">
            <i class="fa-solid fa-phone"></i>
          </div>

          <div>
            <h5>We Will Contact You</h5>
            <p>Our team will contact you regarding your requirement.</p>
          </div>
        </div>

        <div class="next-step">
          <div class="step-icon">
            <i class="fa-solid fa-handshake"></i>
          </div>

          <div>
            <h5>Get Professional Assistance</h5>
            <p>
              We will discuss your requirement and guide you with the next
              steps.
            </p>
          </div>
        </div>
      </div>

      <!-- QUICK MESSAGE -->

      <div class="quick-message">
        <i class="fa-regular fa-clock"></i>

        <span>
          Please keep your phone available so our team can reach you easily.
        </span>
      </div>

      <!-- BUTTONS -->

      <div class="success-buttons">
        <a href="/" class="home-btn">
          <i class="fa-solid fa-house"></i>

          Back to Home
        </a>

        <a
          href="https://wa.me/919876543210"
          target="_blank"
          class="whatsapp-success-btn"
        >
          <i class="fa-brands fa-whatsapp"></i>

          Chat on WhatsApp
        </a>
      </div>

      <!-- FOOTER MESSAGE -->

      <div class="thank-you-text">
        <i class="fa-solid fa-heart"></i>

        Thank you for choosing
        <strong>DS Bhise & Company</strong>
      </div>
    </div>
  </div>
</section>
```
